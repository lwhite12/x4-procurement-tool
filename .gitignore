# it here.
XTools_1.11/

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Editor/OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code's own local (machine-specific) settings -- permission
# allowlist entries reference this machine's temp paths, not meant to be
# shared/tracked (unlike a team-shared .claude/settings.json, if one is
# ever added).
.claude/settings.local.json
